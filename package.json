{
  "name": "restaurant-online-reservation-system-g13",
  "version": "1.0.0",
  "description": "The project is a backend application that exposes a documented RESTful API for an online restaurant reservation system. It maintains information about restaurant tables, opening hours and available time slots, customer reservations, and the daily schedule used by restaurant staff.  Swagger/OpenAPI.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YiYang567/Restaurant-Online-Reservation-System-G13.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/YiYang567/Restaurant-Online-Reservation-System-G13/issues"
  },
  "homepage": "https://github.com/YiYang567/Restaurant-Online-Reservation-System-G13#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}
